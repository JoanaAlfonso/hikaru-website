// ── RENDER CARDS ─────────────────────────────────────────────────
function renderPF(filter){
  var grid = document.getElementById('pf-grid');
  grid.innerHTML = '';
  var list = filter === 'all' ? PF : PF.filter(function(x){ return x.cat === filter; });
  if(!list.length){ grid.innerHTML = '<div class="col-span-full text-center py-16 text-pink-400 text-sm font-medium">No works in this category yet.</div>'; return; }
  list.forEach(function(item){
    var cm = item.media[item.coverIdx] || item.media[0];
    var src = (cm.t === 'image') ? cm.url : item.logo;
    var isVid = cm.t === 'video';
    var card = document.createElement('div');
    card.className = 'glass-card glass-card-hover rounded-2xl overflow-hidden cursor-pointer group flex flex-col bg-white border border-pink-200';
    card.style.aspectRatio = '1/1';
    card.onclick = function(){ openPfModal(item.id); };
    card.innerHTML =
      '<div class="relative overflow-hidden bg-pink-100 flex-shrink-0" style="height:62%">' +
        '<img src="'+src+'" alt="'+item.name+'" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.src=\''+item.logo+'\'">' +
        (isVid ? '<div class="absolute inset-0 flex items-center justify-center pointer-events-none"><div class="w-12 h-12 rounded-full bg-black/30 backdrop-blur-sm border-2 border-white/60 flex items-center justify-center"><i class="fa-solid fa-play text-white text-base ml-0.5"></i></div></div>' : '') +
        '<div class="absolute inset-0 bg-gradient-to-t from-pink-950/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-3">' +
          '<span class="text-white text-[11px] font-bold bg-pink-600 px-2.5 py-1 rounded-full"><i class="fa-solid fa-expand mr-1"></i>Open Gallery ('+item.media.length+')</span>' +
        '</div>' +
        '<span class="absolute top-2.5 left-2.5 text-[10px] font-bold text-pink-900 bg-white/95 backdrop-blur-sm px-2.5 py-0.5 rounded-full border border-pink-200 shadow-sm">'+item.catLabel+'</span>' +
      '</div>' +
      '<div class="flex flex-col flex-1 justify-between p-4 min-h-0">' +
        '<div class="min-h-0">' +
          '<h3 class="font-extrabold text-sm text-pink-950 mb-1 line-clamp-1">'+item.name+'</h3>' +
          '<p class="text-xs text-pink-900/75 leading-relaxed line-clamp-2">'+item.short+'</p>' +
        '</div>' +
        '<div class="pt-2 mt-2 border-t border-pink-100 flex items-center justify-between text-xs font-bold text-pink-700 flex-shrink-0">' +
          '<span><i class="fa-solid fa-images mr-1"></i>'+item.media.length+' Items</span>' +
          '<span class="text-pink-600 flex items-center gap-1">View Work <i class="fa-solid fa-arrow-right text-[10px]"></i></span>' +
        '</div>' +
      '</div>';
    grid.appendChild(card);
  });
}

// ── FILTER ───────────────────────────────────────────────────────
function filterPortfolio(cat){
  document.querySelectorAll('.pf-btn').forEach(function(b){
    b.className = b.getAttribute('data-f') === cat
      ? 'pf-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-pink-600 text-white shadow-md'
      : 'pf-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-pink-100 hover:bg-pink-200 text-pink-900';
  });
  renderPF(cat);
}

// ── MODAL ────────────────────────────────────────────────────────
var curMedia = [];
function openPfModal(id){
  var item = null;
  for(var i=0;i<PF.length;i++){ if(PF[i].id===id){ item=PF[i]; break; } }
  if(!item) return;
  document.getElementById('pf-modal-logo').src   = item.logo;
  document.getElementById('pf-modal-name').innerText = item.name;
  document.getElementById('pf-modal-cat').innerText  = item.catLabel;
  document.getElementById('pf-modal-desc').innerHTML = item.desc;
  document.getElementById('pf-thumb-count').innerText = item.media.length;
  curMedia = item.media;
  var strip = document.getElementById('pf-thumb-strip');
  strip.innerHTML = '';
  item.media.forEach(function(m, idx){
    var th = document.createElement('div');
    th.className = 'w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden flex-shrink-0 border-2 cursor-pointer transition-all ' + (idx===0 ? 'border-pink-600 opacity-100' : 'border-transparent opacity-60 hover:opacity-100');
    if(m.t === 'video'){
      th.innerHTML = '<div class="w-full h-full bg-gradient-to-br from-pink-500 to-rose-600 flex flex-col items-center justify-center gap-1"><i class="fa-solid fa-circle-play text-white text-xl"></i><span class="text-[8px] font-bold text-white/80">VIDEO</span></div>';
    } else {
      th.innerHTML = '<img src="'+m.url+'" class="w-full h-full object-cover">';
    }
    th.addEventListener('click',(function(i){ return function(){ selectMedia(i); }; })(idx));
    strip.appendChild(th);
  });
  selectMedia(0);
  document.getElementById('pf-modal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function selectMedia(idx){
  var main = document.getElementById('pf-media-main');
  var m = curMedia[idx];
  if(!m) return;
  main.innerHTML = m.t === 'video'
    ? '<iframe src="'+m.url+'" class="w-full h-full border-0 rounded-2xl" allow="autoplay;encrypted-media" allowfullscreen></iframe>'
    : '<img src="'+m.url+'" class="w-full h-full object-contain rounded-2xl">';
  var thumbs = document.getElementById('pf-thumb-strip').children;
  for(var i=0;i<thumbs.length;i++){
    thumbs[i].className = thumbs[i].className.replace('border-pink-600','border-transparent').replace('opacity-100','opacity-60');
    if(i===idx){ thumbs[i].className = thumbs[i].className.replace('border-transparent','border-pink-600').replace('opacity-60','opacity-100'); }
  }
  if(thumbs[idx]) thumbs[idx].scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});
}

function closePfModal(){
  document.getElementById('pf-modal').style.display = 'none';
  document.getElementById('pf-media-main').innerHTML = '';
  document.body.style.overflow = '';
}

document.getElementById('pf-modal').addEventListener('click', function(e){ if(e.target===this) closePfModal(); });
document.addEventListener('keydown', function(e){ if(e.key==='Escape') closePfModal(); });

// ── INIT ─────────────────────────────────────────────────────────
renderPF('all');
</script>
